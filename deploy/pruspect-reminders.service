# /etc/systemd/system/pruspect-reminders.service
# Optional: pre-generates in-app reminder notifications. (They are also generated
# whenever the app polls notifications, so this only matters if nobody is signed in.)
[Unit]
Description=PRUspect in-app reminder generation

[Service]
Type=oneshot
User=pruspect
WorkingDirectory=/srv/pruspect/backend
EnvironmentFile=/srv/pruspect/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/pruspect/backend/.venv/bin/python manage.py generate_reminders

# Pair with /etc/systemd/system/pruspect-reminders.timer:
# [Timer]
# OnCalendar=*:0/5
# Persistent=true
# [Install]
# WantedBy=timers.target
