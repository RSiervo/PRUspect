# Copy to frontend/.env.local if you need to override defaults. No secrets belong here —
# everything prefixed VITE_ is embedded in the public JavaScript bundle.

# API base path. Keep the default when Nginx (or the Vite proxy) serves /api on the same origin.
VITE_API_BASE_URL=/api/v1

# Dev server only: where the Vite proxy forwards /api requests.
VITE_DEV_API_PROXY=http://127.0.0.1:8799
