# Copy to backend/.env and fill in. Never commit the real .env.

# config.settings.dev for local work, config.settings.prod on a server.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Optional separate key for signing JWTs (defaults to DJANGO_SECRET_KEY).
JWT_SIGNING_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://pruspect:change-me@localhost:5433/pruspect

# Browser origins allowed to call the API (only needed if the SPA is served from another origin).
CORS_ALLOWED_ORIGINS=http://localhost:5799,http://127.0.0.1:5799
CSRF_TRUSTED_ORIGINS=http://localhost:5799,http://127.0.0.1:5799

# Token lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Refresh-token cookie. Must be True in production (HTTPS).
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Strict

# Google sign-in / sign-up (optional). OAuth client of type "Web application" from
# Google Cloud Console; the button appears only when this is set.
GOOGLE_CLIENT_ID=
# Allow new accounts via Google (existing users can always sign in).
GOOGLE_SIGNUP_ENABLED=True
# Optional: only allow these email domains to sign up, e.g. gmail.com,yourcompany.com
GOOGLE_ALLOWED_DOMAINS=

# Default display timezone for new users.
DEFAULT_TIME_ZONE=Asia/Manila

# Rate limits for auth endpoints
THROTTLE_LOGIN=10/min
THROTTLE_REFRESH=60/min

# Production only
# REDIS_URL=redis://127.0.0.1:6379/1      # shared cache so rate limits work across Gunicorn workers
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# Phone/desktop push notifications (see README). Leave empty to turn push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Scheduler endpoint secret (POST /api/v1/cron/run/). Empty = disabled.
CRON_SECRET=

# Admin pages require two-step verification
ADMIN_REQUIRE_2FA=True

# Error alert emails to admins (any SMTP; Gmail needs an app password). Empty EMAIL_HOST = no emails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=PRUspect <you@gmail.com>
# ERROR_ALERT_EMAILS=extra@example.com
SITE_URL=https://pruspect.vercel.app
